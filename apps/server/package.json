{
  "name": "@cld/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env.development --env-file-if-exists=../../.env.local src/main.ts",
    "build": "tsup",
    "start": "node dist/main.js",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@cld/mdl": "workspace:*",
    "@cld/model": "workspace:*",
    "@cld/render": "workspace:*",
    "@cld/shared": "workspace:*",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/websocket": "^11.3.4",
    "@hocuspocus/server": "^4.8.0",
    "better-auth": "^1.7.14",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^4.0.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@types/ws": "^8.18.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "ws": "^8.22.1"
  }
}
