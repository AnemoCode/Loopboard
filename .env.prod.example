# Configuration for the production stack (docker-compose.prod.yml).
# On the server: cp /opt/loopwise/.env.example /opt/loopwise/.env and fill it in.

# Required: at least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Required: the public URL people open (must match exactly, used for auth and CSRF checks)
PUBLIC_URL=https://loopwise.example.com

# Required: URL-safe characters only (it goes into the DATABASE_URL), e.g. `openssl rand -hex 24`
POSTGRES_PASSWORD=

# Host port the web container listens on; point the Nginx Proxy Manager proxy host here.
WEB_PORT=8473
# Interface to publish on. Use 127.0.0.1 if the proxy runs on the host network.
WEB_BIND=0.0.0.0

# Optional social sign-in (callback URL: <PUBLIC_URL>/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
