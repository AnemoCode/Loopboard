{UTF-8}
Demand for Ambu Products  = A FUNCTION OF( Brand Loyalty to Ambu,Price per Product)
	~	
	~		|

Ambu Labor Intensity  = A FUNCTION OF( "Hospital Staff Training in Endoscope Use (by Ambu)"\
		)
	~	
	~		|

Brand Loyalty to Ambu  = A FUNCTION OF( Hospital Satisfaction)
	~	
	~		|

"After-use Effort of Hospital (collection of Product)"  = A FUNCTION OF( "No. of Reusable Ambu Products in Circulation"\
		)
	~	
	~		|

"Number of Single-Use Ambu Products"  = A FUNCTION OF( "No. of Reusable Ambu Products in Circulation"\
		)
	~	
	~		|

Cleaning Facility Workload  = A FUNCTION OF( "No. of Reusable Ambu Products in Circulation"\
		)
	~	
	~		|

Clinical Treatment Accurracy  = A FUNCTION OF( Proper Use of Modular Endoscope)
	~	
	~		|

Hospital Satisfaction  = A FUNCTION OF( Clinical Treatment Accurracy,Hospital Staff Workload\
		,Waste Disposal Cost of Hospital)
	~	
	~		|

Hospital Staff Workload  = A FUNCTION OF( "After-use Effort of Hospital (collection of Product)"\
		)
	~	
	~		|

"No. of Reusable Ambu Products in Circulation"  = A FUNCTION OF( Demand for Ambu Products\
		)
	~	
	~		|

Price per Product  = A FUNCTION OF( Cleaning Facility Workload)
	~	
	~		|

Proper Use of Modular Endoscope  = A FUNCTION OF( Application Skills of Endoscope of Hospital Staff\
		)
	~	
	~		|

Application Skills of Endoscope of Hospital Staff  = A FUNCTION OF( "Hospital Staff Training in Endoscope Use (by Ambu)"\
		)
	~	
	~		|

"Hospital Staff Training in Endoscope Use (by Ambu)"  = A FUNCTION OF( Demand for Ambu Products\
		)
	~	
	~		|

Hospital Waste  = A FUNCTION OF( "Number of Single-Use Ambu Products")
	~	
	~		|

Waste Disposal Cost of Hospital  = A FUNCTION OF( Hospital Waste)
	~	
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 100
	~	Month
	~	The final time for the simulation.
	|

INITIAL TIME  = 0
	~	Month
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Month [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Month [0,?]
	~	The time step for the simulation.
	|

