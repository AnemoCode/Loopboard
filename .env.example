# Configuration for the Docker stack (compose.yaml). Copy to .env and adjust.

# Required: at least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# Public URL people use to open the app (must match exactly, used for auth and CSRF checks)
PUBLIC_URL=http://localhost:8080

# Caddy site address: ":80" for plain HTTP, or your domain (e.g. loopwise.example.com) for automatic HTTPS.
# With a domain, also set HTTP_PORT=80, HTTPS_PORT=443 and PUBLIC_URL=https://loopwise.example.com
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443

POSTGRES_PASSWORD=change-me

# Optional social sign-in (callback URL: <PUBLIC_URL>/api/auth/callback/<provider>)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
