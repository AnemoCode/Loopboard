# Copy to .env for local development (`cp .env.example .env`).
DATABASE_URL=postgres://loopwise:loopwise@localhost:5433/loopwise
PUBLIC_URL=http://localhost:5173
# At least 32 random characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=dev-secret-change-me-dev-secret-change-me
# Optional social sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
